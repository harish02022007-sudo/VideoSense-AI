# =====================================================================
# VideoSense AI - Environment Configuration Template
# =====================================================================
# Copy this file to '.env' and fill in your actual environment values:
#   cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# Application & Server Settings
# ---------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=your_secret_key_here_change_in_production

# ---------------------------------------------------------------------
# Database Persistence (PostgreSQL Primary / SQLite Fallback)
# ---------------------------------------------------------------------
# PostgreSQL configuration:
DATABASE_URL=postgresql://user:password@localhost:5432/videosense_db
# Fallback SQLite configuration (used if PostgreSQL is unavailable):
# DATABASE_URL=sqlite:///./storage/videosense.db

# ---------------------------------------------------------------------
# Cryptographic Security & JWT Token Management
# ---------------------------------------------------------------------
# Strong 256-bit secret used to sign and verify JSON Web Tokens (JWT)
VIDEOSENSE_JWT_SECRET=your_jwt_secret_key_here_generate_with_openssl_rand_hex_32
VIDEOSENSE_JWT_ALGORITHM=HS256
VIDEOSENSE_ACCESS_TOKEN_EXPIRE_MINUTES=120
VIDEOSENSE_REFRESH_TOKEN_EXPIRE_DAYS=7

# Cryptographic Pepper used for salting 6-digit OTP verification hashes
VIDEOSENSE_OTP_PEPPER=your_otp_pepper_secret_here

# ---------------------------------------------------------------------
# Email Delivery Service (SMTP - Gmail, SendGrid, Amazon SES, Mailgun)
# ---------------------------------------------------------------------
# Real-world email OTP delivery for account verification and password resets
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_email_app_password_here
SMTP_TLS=true
SMTP_SENDER=your_email@example.com

# ---------------------------------------------------------------------
# AI Models & Vision Processing Pipelines
# ---------------------------------------------------------------------
YOLO_MODEL_NAME=yolov8x.pt
GROUNDING_DINO_CONFIG=groundingdino/config/GroundingDINO_SwinT_OGC.py
GROUNDING_DINO_WEIGHTS=weights/groundingdino_swint_ogc.pth
WHISPER_MODEL_SIZE=base
DEVICE=cuda

# ---------------------------------------------------------------------
# Frontend Environment (Vite)
# ---------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
